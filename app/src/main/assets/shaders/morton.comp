#version 310 es
layout(local_size_x = 128) in;

struct Surfel {
    vec4 pos;     // xyz, radius
    vec4 normal;  // xyz, confidence
    vec4 color;
    vec4 extra;   // id, timestamp
};

layout(std430, binding = 0) readonly buffer InBuf {
    Surfel surfels[];
};

layout(std430, binding = 1) writeonly buffer KeyBuf {
    uint keys[];
};

layout(std430, binding = 2) writeonly buffer IndexBuf {
    uint indices[];
};

uniform float cellSize;
uniform vec3 worldMin;
uniform uint uCount;

uint expandBits(uint v) {
    v = (v * 0x00010001u) & 0xFF0000FFu;
    v = (v * 0x00000101u) & 0x0F00F00Fu;
    v = (v * 0x00000011u) & 0xC30C30C3u;
    v = (v * 0x00000005u) & 0x49249249u;
    return v;
}

uint morton3(vec3 p) {
    uvec3 ip = uvec3(clamp(p, 0.0, 1023.0));
    return expandBits(ip.x) | (expandBits(ip.y) << 1) | (expandBits(ip.z) << 2);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uCount) return;

    Surfel s = surfels[id];

    if (s.pos.w <= 0.0) {
        keys[id] = 0xFFFFFFFFu;
        indices[id] = id;
        return;
    }

    vec3 grid = floor((s.pos.xyz - worldMin) / cellSize);
    uint key = morton3(grid);

    keys[id] = key;
    indices[id] = id;
}
