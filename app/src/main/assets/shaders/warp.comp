#version 310 es
layout(local_size_x = 128) in;

struct Surfel {
    vec4 posRadius;   // 0-15: xyz, radius
    vec4 normalConf;  // 16-31: xyz, confidence
    vec4 color;       // 32-47: rgb, unused
    uvec2 id;         // 48-55: 64-bit ID (low, high)
    uvec2 timestamp;  // 56-63: 64-bit Timestamp (low, high)
};

layout(std430, binding = 0) buffer Surfels {
    Surfel surfels[];
};

struct WarpControlPoint {
    vec4 origin; // xyz + radius of influence
    vec4 delta;  // xyz + weight
};

layout(std430, binding = 1) buffer WarpField {
    WarpControlPoint controlPoints[];
};

uniform int uSurfelCount;
uniform int uControlPointCount;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uSurfelCount)) return;

    vec3 p = surfels[id].posRadius.xyz;
    vec3 totalDelta = vec3(0.0);

    for (int i = 0; i < uControlPointCount; i++) {
        WarpControlPoint cp = controlPoints[i];
        float dist = distance(p, cp.origin.xyz);
        float influence = exp(-dist * dist / (2.0 * cp.origin.w * cp.origin.w));
        totalDelta += cp.delta.xyz * influence * cp.delta.w;
    }

    surfels[id].posRadius.xyz = p + totalDelta;
}
