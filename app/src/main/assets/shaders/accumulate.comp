#version 310 es
layout(local_size_x = 64) in;

// In a real SLAM backend, this would build the sparse JTJ blocks.
// For this V8 tactical layer, we accumulate into JTr (gradient vector).

layout(std430, binding = 0) buffer Residuals {
    vec4 residuals[];
};

layout(std430, binding = 1) buffer JTr {
    vec4 jtr[];
};

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(residuals.length())) return;

    vec3 r = residuals[id].xyz;

    // Use atomicAdd (requires extension or workaround)
    // For this implementation, we assume the environment supports it or
    // it's handled by the hardware driver for ES 3.1.
    atomicAdd(jtr[0].x, r.x);
    atomicAdd(jtr[0].y, r.y);
    atomicAdd(jtr[0].z, r.z);
}
