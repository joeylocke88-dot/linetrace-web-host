#version 310 es
layout(local_size_x = 128) in;

struct Surfel {
    vec4 posRadius;   // 0-15: xyz, radius
    vec4 normalConf;  // 16-31: xyz, confidence
    vec4 color;       // 32-47: rgb, unused
    uvec2 id;         // 48-55: 64-bit ID (low, high)
    uvec2 timestamp;  // 56-63: 64-bit Timestamp (low, high)
};

layout(std430, binding = 0) readonly buffer InBuffer {
    Surfel surfels[];
};

layout(std430, binding = 1) writeonly buffer OutBuffer {
    Surfel outSurfels[];
};

layout(std430, binding = 2) buffer Counter {
    uint count;
};

uniform vec3 regionCenter;
uniform float radius;
uniform uint maxInCount;
uniform bool extractInside; // true = inside radius, false = outside radius

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= maxInCount) return;

    Surfel s = surfels[id];

    // Check if valid (radius > 0)
    if (s.posRadius.w <= 0.0) return;

    float d = distance(s.posRadius.xyz, regionCenter);

    bool condition = extractInside ? (d < radius) : (d >= radius);

    if (condition) {
        uint idx = atomicAdd(count, 1u);
        outSurfels[idx] = s;

        // If we are extracting to "page out", we should mark the original as invalid
        // But since InBuffer is readonly, we'd need another pass or make it readwrite.
        // For V12 streaming, we typically extract the set to save, then the next fusion/compress
        // will naturally clear the buffer or we'll swap it.
    }
}